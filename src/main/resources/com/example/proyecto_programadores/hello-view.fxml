<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="421.0" prefWidth="340.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyecto_programadores.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <HBox prefHeight="100.0" prefWidth="200.0">
      <children>
         <ImageView fitHeight="64.0" fitWidth="76.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@imagenes/imagen1.png" />
            </image>
         </ImageView>
         <Label prefHeight="61.0" prefWidth="185.0" text="Comunidad de Programadores">
            <HBox.margin>
               <Insets left="40.0" />
            </HBox.margin></Label>
      </children>
   </HBox>
   <VBox prefHeight="200.0" prefWidth="100.0">
      <children>
         <HBox prefHeight="100.0" prefWidth="200.0">
            <children>
               <Label text="Contraseña:" />
               <TextField>
                  <HBox.margin>
                     <Insets left="32.0" />
                  </HBox.margin>
               </TextField>
            </children>
         </HBox>
         <HBox prefHeight="100.0" prefWidth="200.0">
            <children>
            
                <Label fx:id="welcomeText" alignment="TOP_LEFT" prefHeight="17.0" prefWidth="95.0" text="Usuario:" />
               <TextField />
            </children></HBox>
      </children>
   </VBox>
   <HBox layoutX="30.0" layoutY="154.0" prefHeight="47.0" prefWidth="295.0">
      <children>
         <Button mnemonicParsing="false" text="Loggin">
            <graphic>
               <ImageView fitHeight="16.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@imagenes/icono_loggin.png" />
                  </image>
               </ImageView>
            </graphic>
            <HBox.margin>
               <Insets left="20.0" />
            </HBox.margin>
         </Button>
         <Button contentDisplay="LEFT" mnemonicParsing="false" prefHeight="26.0" prefWidth="122.0" text="Registrarse">
            <HBox.margin>
               <Insets left="20.0" />
            </HBox.margin>
            <graphic>
               <ImageView fitHeight="18.0" fitWidth="39.0" nodeOrientation="RIGHT_TO_LEFT" pickOnBounds="true" preserveRatio="true">
                  <Image url="@imagenes/iconregist.png" />
               </ImageView>
            </graphic>
         </Button>
      </children>
   </HBox>
   <HBox prefHeight="11.0" prefWidth="109.0">
      <children>
         <ImageView fitHeight="95.0" fitWidth="277.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@imagenes/imagen2.png" />
            </image>
            <HBox.margin>
               <Insets left="80.0" />
            </HBox.margin>
         </ImageView>
      </children>
   </HBox>
</VBox>
